    "A short story every day, written with your words and read aloud by Dr Tusk." : {
      "comment" : "Paywall benefit detail for daily stories.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una historia corta cada día, escrita con tus palabras y leída en voz alta por Dr Tusk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag eine kurze Geschichte, mit deinen Wörtern geschrieben und von Dr Tusk vorgelesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite histoire chaque jour, écrite avec tes mots et lue à voix haute par Dr Tusk."
          }
        },
        "it" : {
          "stringUnit" : {
