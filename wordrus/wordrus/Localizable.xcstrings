        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Wörter beginnen auf deinem Niveau; leichtere kommen erst, wenn dein Niveau ausgeschöpft ist. Wörter, die du schon wiederholst, sind nicht betroffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux mots commencent à ton niveau ; les plus faciles n'apparaissent qu'une fois ton niveau épuisé. Les mots que tu révises déjà ne sont pas concernés."
