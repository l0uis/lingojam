    "A real start — greetings and the basics are yours." : {
      "comment" : "Vocabulary progress (Words tab header / Your progress sheet).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un buen comienzo: ya dominas los saludos y lo básico."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein echter Anfang — Begrüßungen und Grundlagen sitzen."
