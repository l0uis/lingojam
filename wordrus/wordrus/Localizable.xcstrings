    "%@ recognizer is offline. Check internet or download the language pack in Settings → General → Keyboard → Dictation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung für %@ ist offline. Prüfe deine Internetverbindung oder lade das Sprachpaket unter Einstellungen → Allgemein → Tastatur → Diktierfunktion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz en %@ no está disponible. Revisa tu conexión o descarga el paquete de idioma en Ajustes → General → Teclado → Dictado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale (%@) est hors ligne. Vérifie ta connexion ou télécharge le pack de langue dans Réglages → Général → Clavier → Dictée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale per %@ è offline. Controlla la connessione o scarica il pacchetto lingua in Impostazioni → Generali → Tastiera → Dettatura."
          }
        }
      }
    },
    "%@ speakers learn %@ in Wordrus. Your current words and progress are kept and come back if you switch back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer %@ spricht, lernt in Wordrus %@. Deine aktuellen Wörter und dein Fortschritt bleiben erhalten und sind wieder da, wenn du zurückwechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes hablan %@ aprenden %@ en Wordrus. Tus palabras y tu progreso actuales se guardan y vuelven si cambias de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue parlée : %@ · langue apprise dans Wordrus : %@. Tes mots et ta progression actuels sont conservés et reviendront si tu changes à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi parla %@ impara %@ con Wordrus. Le tue parole e i tuoi progressi attuali restano salvati e ritornano se torni indietro."
          }
        }
      }
    },
