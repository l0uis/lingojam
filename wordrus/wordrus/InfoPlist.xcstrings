    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus listens while you speak to Walter so it can transcribe your replies in chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus te escucha mientras hablas con Walter para transcribir tus respuestas en el chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus hört zu, während du mit Walter sprichst, damit deine Antworten im Chat transkribiert werden können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus écoute quand tu parles à Walter afin de transcrire tes réponses dans le chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus ti ascolta mentre parli con Walter per trascrivere le tue risposte nella chat."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus turns your speech into text so you can practice talking with Walter instead of typing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus convierte tu voz en texto para que puedas practicar hablando con Walter en vez de escribir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus wandelt deine Sprache in Text um, damit du mit Walter sprechen üben kannst, statt zu tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus transforme ta voix en texte pour que tu puisses t'entraîner à parler avec Walter au lieu d'écrire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordrus trasforma la tua voce in testo così puoi esercitarti a parlare con Walter invece di scrivere."
          }
        }
      }
    }
  },
  "version" : "1.0"
